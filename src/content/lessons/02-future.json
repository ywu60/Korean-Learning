            "past": { "id": "s2-cmp-apply-past", "korean": "나는 그 회사에 지원했어.", "romanization": "Naneun geu hoesae jiwonhaesseo.", "english": "I applied to that company.", "highlight": "했어" },
            "future": { "id": "s2-cmp-apply-future", "korean": "나는 그 회사에 지원할 거야.", "romanization": "Naneun geu hoesae jiwonhal geoya.", "english": "I will apply to that company.", "highlight": "할 거야" }
          }
        },
        {
          "id": "study",
          "label": "study Korean (review)",
          "vocabularyId": "study",
