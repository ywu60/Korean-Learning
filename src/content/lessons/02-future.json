            "past": { "id": "s2-cmp-coffee-past", "korean": "나는 커피를 샀어.", "romanization": "Naneun keopireul sasseo.", "english": "I bought coffee.", "highlight": "샀어" },
            "future": { "id": "s2-cmp-coffee-future", "korean": "나는 커피를 살 거야.", "romanization": "Naneun keopireul sal geoya.", "english": "I will buy coffee.", "highlight": "살 거야" }
