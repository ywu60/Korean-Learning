      "title": "Quick check: progressive",
      "questions": [
        {
          "id": "q-s3-progressive-write",
          "type": "multipleChoice",
          "prompt": "How do you say \"am writing\" with 쓰다 (to write)?",
          "options": [
            { "id": "a", "text": "쓰고 있어" },
            { "id": "b", "text": "썼어" },
            { "id": "c", "text": "쓸 거야" }
          ],
          "correctOptionId": "a",
          "explanation": "Stem 쓰 + 고 있어 → 쓰고 있어 (sseugo isseo). 썼어 is the past and 쓸 거야 is the future.",
          "conceptIds": ["progressive-go-isseo"],
          "vocabularyIds": ["write"]
        },
        {
