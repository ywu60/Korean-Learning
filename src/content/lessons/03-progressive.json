            { "text": "집에서", "romanization": "jibeseo", "meaning": "at home (where the action happens)", "role": "location", "marker": "에서", "vocabularyId": "home", "grammarConceptId": "location-eseo" },
            { "text": "운동하고 있어", "romanization": "undonghago isseo", "meaning": "am exercising", "role": "verb", "marker": "고 있어", "vocabularyId": "exercise", "grammarConceptId": "progressive-go-isseo" }
