            { "text": "지금", "romanization": "jigeum", "meaning": "now", "role": "time", "vocabularyId": "now" },
            { "text": "편지를", "romanization": "pyeonjireul", "meaning": "letter (object)", "role": "object", "marker": "를", "vocabularyId": "letter", "grammarConceptId": "object-eul-reul" },
            { "text": "쓰고 있어", "romanization": "sseugo isseo", "meaning": "am writing", "role": "verb", "marker": "고 있어", "vocabularyId": "write", "grammarConceptId": "progressive-go-isseo" }
